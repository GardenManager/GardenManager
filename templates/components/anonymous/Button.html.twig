{% props color = 'neutral', size = 'md', outline = false, href = null, type = 'button', class = '' %}

{% set size_map = {
    xs: 'px-2.5 py-1.5 text-xs',
    sm: 'px-3 py-2 text-xs',
    md: 'px-5 py-2.5 text-sm',
    lg: 'px-5 py-3 text-base',
} %}

{% set color_map = {
    primary: outline
        ? 'text-blue-700 border border-blue-700 hover:bg-blue-800 hover:text-white focus:ring-blue-300 dark:text-blue-500 dark:border-blue-500 dark:hover:bg-blue-500 dark:hover:text-white dark:focus:ring-blue-800'
        : 'text-white bg-blue-700 hover:bg-blue-800 focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800',
    error: outline
        ? 'text-red-700 border border-red-700 hover:bg-red-800 hover:text-white focus:ring-red-300 dark:text-red-500 dark:border-red-500 dark:hover:bg-red-600 dark:hover:text-white dark:focus:ring-red-900'
        : 'text-white bg-red-700 hover:bg-red-800 focus:ring-red-300 dark:bg-red-600 dark:hover:bg-red-700 dark:focus:ring-red-900',
    neutral: outline
        ? 'text-gray-900 border border-gray-200 hover:bg-gray-100 focus:ring-gray-100 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-700'
        : 'text-gray-900 bg-white border border-gray-200 hover:bg-gray-100 focus:ring-gray-100 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-700',
} %}

{% set base = 'font-medium rounded-lg text-center focus:ring-4 focus:outline-none inline-flex items-center' %}
{% set css = (base ~ ' ' ~ (size_map[size]|default(size_map.md)) ~ ' ' ~ (color_map[color]|default(color_map.neutral)) ~ ' ' ~ class)|trim %}

{% set button_content %}{% block content %}{% endblock %}{% endset %}

{% if href %}
    <a href="{{ href }}" class="{{ css }}" {{ attributes }}>{{ button_content|raw }}</a>
{% else %}
    <button type="{{ type }}" class="{{ css }}" {{ attributes }}>{{ button_content|raw }}</button>
{% endif %}
