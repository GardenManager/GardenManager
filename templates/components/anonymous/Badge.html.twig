{% props color = 'neutral', size = 'md' %}

{% set size_map = {
    sm: 'text-xs font-medium px-2 py-0.5',
    md: 'text-xs font-medium px-2.5 py-0.5',
    lg: 'text-sm font-medium px-3 py-1',
} %}

{% set color_map = {
    neutral: 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300',
    primary: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300',
    success: 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-300',
    error: 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-300',
    warning: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300',
} %}

<span class="rounded-full {{ size_map[size]|default(size_map.md) }} {{ color_map[color]|default(color_map.neutral) }}">
    {% block content %}{% endblock %}
</span>
