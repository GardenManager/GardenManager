{% extends 'layout/dashboard.html.twig' %}

{% block page_title %}Raw Permission Editor{% endblock %}

{% block content %}
    <div class="mb-6">
        <a href="{{ path('tenant_show') }}" class="text-blue-600 hover:underline dark:text-blue-500 text-sm">&larr; Back to Tenant Settings</a>
    </div>

    <twig:Card>
        <div class="px-6 py-4">
            <p class="text-sm text-gray-500 dark:text-gray-400 mb-4">
                Edit the raw JSON permission configuration. Use <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">+</code> prefix for grants and <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">-</code> prefix for denials (e.g. <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">+plant.view</code>, <code class="bg-gray-100 dark:bg-gray-700 px-1 rounded">-plant.delete</code>).
            </p>
            {{ form_start(form) }}
                {{ form_widget(form.permissionsJson) }}
                <div class="flex justify-end mt-4">
                    <twig:Button type="submit" color="primary">Save Configuration</twig:Button>
                </div>
            {{ form_end(form) }}
        </div>
    </twig:Card>
{% endblock %}
