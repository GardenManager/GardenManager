{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %}{{ seller.name }}{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <nav class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="text-lg font-semibold text-gray-900">
                    <a href="{{ path('app_dashboard') }}" class="hover:text-gray-700">GardenManager</a>
                </div>
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-gray-700">{{ app.user.displayName }}</span>
                    <a href="{{ path('app_logout') }}"
                        class="text-sm text-red-600 hover:text-red-500 font-medium">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        {% for message in app.flashes('success') %}
            <div class="mb-4 rounded-md bg-green-50 p-4">
                <p class="text-sm font-medium text-green-800">{{ message }}</p>
            </div>
        {% endfor %}

        <div class="mb-6">
            <a href="{{ path('seller_index') }}" class="text-sm text-indigo-600 hover:text-indigo-500">&larr; Back to sellers</a>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6">
            <div class="flex items-center justify-between mb-6">
                <h1 class="text-2xl font-bold text-gray-900">{{ seller.name }}</h1>
                <div class="flex space-x-3">
                    <a href="{{ path('seller_edit', {id: seller.id}) }}"
                        class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
                        Edit
                    </a>
                    <form method="post" action="{{ path('seller_delete', {id: seller.id}) }}"
                          data-controller="confirm"
                          data-action="submit->confirm#onSubmit"
                          data-confirm-message-value="Are you sure you want to delete this seller?">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-seller-' ~ seller.id) }}">
                        <button type="submit"
                            class="inline-flex items-center rounded-md bg-red-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500">
                            Delete
                        </button>
                    </form>
                </div>
            </div>

            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="border rounded-lg p-4">
                    <dt class="text-sm font-medium text-gray-500">Email</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ seller.email }}</dd>
                </div>

                {% if seller.phone %}
                <div class="border rounded-lg p-4">
                    <dt class="text-sm font-medium text-gray-500">Phone</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ seller.phone }}</dd>
                </div>
                {% endif %}

                {% if seller.description %}
                <div class="border rounded-lg p-4 sm:col-span-2">
                    <dt class="text-sm font-medium text-gray-500">Description</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ seller.description }}</dd>
                </div>
                {% endif %}

                {% if seller.address %}
                <div class="border rounded-lg p-4 sm:col-span-2">
                    <dt class="text-sm font-medium text-gray-500">Address</dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {{ seller.address.street }}<br>
                        {{ seller.address.postalCode }} {{ seller.address.city }}<br>
                        {{ seller.address.country }}
                    </dd>
                </div>
                {% endif %}

                <div class="border rounded-lg p-4">
                    <dt class="text-sm font-medium text-gray-500">Created</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ seller.createdAt|date('F j, Y') }}</dd>
                </div>

                <div class="border rounded-lg p-4">
                    <dt class="text-sm font-medium text-gray-500">Updated</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ seller.updatedAt|date('F j, Y') }}</dd>
                </div>
            </dl>
        </div>
    </main>
</div>
{% endblock %}
