{% extends 'layout/dashboard.html.twig' %}

{% block page_title %}{{ seller.name }}{% endblock %}

{% block title_display %}
    <div class="flex justify-between items-center">
        <span>{{ seller.name }}</span>
        <div class="flex gap-2">
            <twig:Button href="{{ path('seller_edit', {id: seller.id}) }}" color="primary" size="sm">Edit</twig:Button>
            <twig:Button color="error" size="sm" data-modal-target="delete-modal" data-modal-toggle="delete-modal">Delete</twig:Button>
        </div>
    </div>
{% endblock %}

{% block content %}
    <nav class="flex mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
            <li class="inline-flex items-center">
                <a href="{{ path('seller_index') }}" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white">
                    Sellers
                </a>
            </li>
            <li aria-current="page">
                <div class="flex items-center">
                    <svg class="rtl:rotate-180 w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                    </svg>
                    <span class="ms-1 text-sm font-medium text-gray-500 md:ms-2 dark:text-gray-400">{{ seller.name }}</span>
                </div>
            </li>
        </ol>
    </nav>

    <twig:Card>
        {% block content %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <tbody>
                        <tr class="border-b border-gray-200 dark:border-gray-700">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Email</th>
                            <td class="px-6 py-4">{{ seller.email }}</td>
                        </tr>
                        {% if seller.phone %}
                            <tr class="border-b border-gray-200 dark:border-gray-700">
                                <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Phone</th>
                                <td class="px-6 py-4">{{ seller.phone }}</td>
                            </tr>
                        {% endif %}
                        {% if seller.description %}
                            <tr class="border-b border-gray-200 dark:border-gray-700">
                                <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Description</th>
                                <td class="px-6 py-4">{{ seller.description }}</td>
                            </tr>
                        {% endif %}
                        {% if seller.address %}
                            <tr class="border-b border-gray-200 dark:border-gray-700">
                                <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Address</th>
                                <td class="px-6 py-4">
                                    {{ seller.address.street }}<br>
                                    {{ seller.address.postalCode }} {{ seller.address.city }}<br>
                                    {{ seller.address.country }}
                                </td>
                            </tr>
                        {% endif %}
                        <tr class="border-b border-gray-200 dark:border-gray-700">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Created</th>
                            <td class="px-6 py-4">{{ seller.createdAt|date('F j, Y') }}</td>
                        </tr>
                        <tr>
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Updated</th>
                            <td class="px-6 py-4">{{ seller.updatedAt|date('F j, Y') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {% endblock %}
    </twig:Card>

    <twig:ConfirmDeleteModal
        action="{{ path('seller_delete', {id: seller.id}) }}"
        entityName="{{ seller.name }}"
    />
{% endblock %}
