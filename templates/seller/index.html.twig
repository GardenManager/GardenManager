{% extends 'layout/dashboard.html.twig' %}

{% block page_title %}My Sellers{% endblock %}

{% block title_display %}
    <div class="flex justify-between items-center">
        <span>My Sellers</span>
        {% if has_permission('seller.create') %}
            <twig:Button href="{{ path('seller_new') }}" color="primary" size="sm">New Seller</twig:Button>
        {% endif %}
    </div>
{% endblock %}

{% block content %}
    <turbo-frame id="seller-list">
        {% if pager.isEmpty() %}
            <twig:EmptyState message="You have no sellers yet.{{ has_permission('seller.create') ? ' Create your first one!' : '' }}">
                {% block actions %}
                    {% if has_permission('seller.create') %}
                        <twig:Button href="{{ path('seller_new') }}" color="primary">New Seller</twig:Button>
                    {% endif %}
                {% endblock %}
            </twig:EmptyState>
        {% else %}
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for seller in pager.items %}
                    {% include 'seller/_card.html.twig' with {seller: seller} %}
                {% endfor %}
            </div>

            <div class="mt-8">
                <twig:Pagination :pager="pager" route="seller_index" />
            </div>
        {% endif %}
    </turbo-frame>
{% endblock %}
