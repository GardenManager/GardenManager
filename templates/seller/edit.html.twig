{% extends 'layout/dashboard.html.twig' %}

{% block page_title %}Edit {{ seller.name }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <a href="{{ path('seller_show', {id: seller.id}) }}" class="text-blue-600 hover:underline dark:text-blue-500 text-sm">&larr; Back to {{ seller.name }}</a>
    </div>

    <twig:Card>
        {% block content %}
            {{ form_start(form) }}
                {{ form_rest(form) }}
            {{ form_end(form) }}
        {% endblock %}
    </twig:Card>
{% endblock %}
