<turbo-frame id="seller-{{ seller.id }}">
    <div class="bg-white rounded-lg shadow p-5">
        <div class="mb-3">
            <h3 class="text-lg font-semibold text-gray-900 truncate">{{ seller.name }}</h3>
        </div>
        <p class="text-sm text-gray-600 mb-3">{{ seller.email }}</p>
        <div class="flex space-x-3">
            <a href="{{ path('seller_show', {id: seller.id}) }}" data-turbo-frame="_top"
                class="text-sm font-medium text-indigo-600 hover:text-indigo-500">View</a>
            <a href="{{ path('seller_edit', {id: seller.id}) }}" data-turbo-frame="_top"
                class="text-sm font-medium text-gray-600 hover:text-gray-500">Edit</a>
        </div>
    </div>
</turbo-frame>
