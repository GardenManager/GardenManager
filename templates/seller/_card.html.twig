<turbo-frame id="seller-{{ seller.id }}">
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700">
        <div class="p-5">
            <h3 class="mb-2 text-xl font-bold tracking-tight text-gray-900 dark:text-white truncate">{{ seller.name }}</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400">{{ seller.email }}</p>
            <div class="flex items-center gap-3 mt-3">
                <a href="{{ path('seller_show', {id: seller.id}) }}" data-turbo-frame="_top" class="text-blue-600 hover:underline dark:text-blue-500 text-sm">View</a>
                <a href="{{ path('seller_edit', {id: seller.id}) }}" data-turbo-frame="_top" class="text-gray-600 hover:underline dark:text-gray-400 text-sm">Edit</a>
            </div>
        </div>
    </div>
</turbo-frame>
