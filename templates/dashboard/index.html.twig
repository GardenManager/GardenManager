{% extends 'layout/dashboard.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}
    <twig:Card>
        {% block title %}Welcome, {{ app.user.displayName }}!{% endblock %}

        {% block content %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <tbody>
                        <tr class="border-b border-gray-200 dark:border-gray-700 odd:bg-white even:bg-gray-50 dark:odd:bg-gray-900 dark:even:bg-gray-800">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Email</th>
                            <td class="px-6 py-4">{{ app.user.email }}</td>
                        </tr>
                        <tr class="border-b border-gray-200 dark:border-gray-700 odd:bg-white even:bg-gray-50 dark:odd:bg-gray-900 dark:even:bg-gray-800">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Verified</th>
                            <td class="px-6 py-4">
                                {% if app.user.verified %}
                                    <twig:Badge color="success">Yes</twig:Badge>
                                {% else %}
                                    <twig:Badge color="error">No</twig:Badge>
                                {% endif %}
                            </td>
                        </tr>
                        <tr class="border-b border-gray-200 dark:border-gray-700 odd:bg-white even:bg-gray-50 dark:odd:bg-gray-900 dark:even:bg-gray-800">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Roles</th>
                            <td class="px-6 py-4">{{ app.user.roles|join(', ') }}</td>
                        </tr>
                        <tr class="odd:bg-white even:bg-gray-50 dark:odd:bg-gray-900 dark:even:bg-gray-800">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Member since</th>
                            <td class="px-6 py-4">{{ app.user.createdAt|date('F j, Y') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {% endblock %}
    </twig:Card>
{% endblock %}
