{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    <nav class="bg-white shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="text-lg font-semibold text-gray-900">GardenManager</div>
                <div class="flex items-center space-x-4">
                    <span class="text-sm text-gray-700">{{ app.user.displayName }}</span>
                    <a href="{{ path('app_logout') }}"
                        class="text-sm text-red-600 hover:text-red-500 font-medium">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-4">Welcome, {{ app.user.displayName }}!</h1>

            <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                <div class="border rounded-lg p-4">
                    <dt class="text-sm font-medium text-gray-500">Email</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ app.user.email }}</dd>
                </div>

                <div class="border rounded-lg p-4">
                    <dt class="text-sm font-medium text-gray-500">Verified</dt>
                    <dd class="mt-1 text-sm text-gray-900">
                        {% if app.user.verified %}
                            <span class="text-green-600">Yes</span>
                        {% else %}
                            <span class="text-red-600">No</span>
                        {% endif %}
                    </dd>
                </div>

                <div class="border rounded-lg p-4">
                    <dt class="text-sm font-medium text-gray-500">Roles</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ app.user.roles|join(', ') }}</dd>
                </div>

                <div class="border rounded-lg p-4">
                    <dt class="text-sm font-medium text-gray-500">Member since</dt>
                    <dd class="mt-1 text-sm text-gray-900">{{ app.user.createdAt|date('F j, Y') }}</dd>
                </div>
            </dl>
        </div>
    </main>
</div>
{% endblock %}
