{% extends 'layout/guest.html.twig' %}

{% block title %}Link your account | Garden Manager{% endblock %}

{% block content %}
    <h2 class="text-2xl font-bold text-center mb-4 text-gray-900 dark:text-white">Link your account</h2>

    <p class="text-sm text-center mb-6 text-gray-600 dark:text-gray-400">
        An account with the email <strong>{{ email }}</strong> already exists.
        Enter your password to link your OpenID Connect login to this account.
    </p>

    {{ form_start(linkForm) }}
        {{ form_row(linkForm.password) }}
        {{ form_row(linkForm.submit, {attr: {class: 'w-full'}}) }}
    {{ form_end(linkForm) }}

    <p class="mt-6 text-center text-sm text-gray-600 dark:text-gray-400">
        <a href="{{ path('app_login') }}" class="text-blue-600 hover:underline dark:text-blue-500">Back to login</a>
    </p>
{% endblock %}
