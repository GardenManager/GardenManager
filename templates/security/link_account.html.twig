{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %}Link your account{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="w-full max-w-md bg-white rounded-lg shadow-md p-8">
        <h1 class="text-2xl font-bold text-center text-gray-900 mb-4">Link your account</h1>

        <p class="text-sm text-gray-600 mb-6 text-center">
            An account with the email <strong>{{ email }}</strong> already exists.
            Enter your password to link your OpenID Connect login to this account.
        </p>

        {% for message in app.flashes('error') %}
            <div class="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(linkForm, {'attr': {'class': 'space-y-4'}}) }}
            <div>
                {{ form_label(linkForm.password, 'Password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(linkForm.password, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500'}}) }}
                {{ form_errors(linkForm.password, {'attr': {'class': 'text-sm text-red-600 mt-1'}}) }}
            </div>

            <button type="submit"
                class="w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition">
                Link account and log in
            </button>
        {{ form_end(linkForm) }}

        <p class="mt-6 text-center text-sm text-gray-600">
            <a href="{{ path('app_login') }}" class="text-green-600 hover:text-green-500 font-medium">Back to login</a>
        </p>
    </div>
</div>
{% endblock %}
