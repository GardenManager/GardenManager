{% extends 'layout/guest.html.twig' %}

{% block title %}Log in | Garden Manager{% endblock %}

{% block content %}
    <h2 class="text-2xl font-bold text-center mb-6 text-gray-900 dark:text-white">Log in</h2>

    {% if error %}
        <twig:Alert type="error">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </twig:Alert>
    {% endif %}

    {{ form_start(form) }}
        {{ form_row(form.email) }}
        {{ form_row(form.password) }}

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}" data-controller="csrf-protection">

        {{ form_row(form.submit, {attr: {class: 'w-full'}}) }}
    {{ form_end(form) }}

    {% if oidc_enabled %}
        <div class="inline-flex items-center justify-center w-full">
            <hr class="w-full h-px my-6 bg-gray-200 border-0 dark:bg-gray-700">
            <span class="absolute px-3 font-medium text-gray-900 -translate-x-1/2 bg-white left-1/2 dark:text-white dark:bg-gray-800">or</span>
        </div>

        <twig:Button href="{{ path('app_oidc_connect') }}" color="neutral" outline="{{ true }}" class="w-full">
            Login with OpenID Connect
        </twig:Button>
    {% endif %}

    <p class="mt-6 text-center text-sm text-gray-600 dark:text-gray-400">
        Don't have an account?
        <a href="{{ path('app_register') }}" class="text-blue-600 hover:underline dark:text-blue-500">Register</a>
    </p>
{% endblock %}
