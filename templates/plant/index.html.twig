{% extends 'layout/dashboard.html.twig' %}

{% block page_title %}My Plants{% endblock %}

{% block title_display %}
    <div class="flex justify-between items-center">
        <span>My Plants</span>
        <twig:Button href="{{ path('plant_new') }}" color="primary" size="sm">New Plant</twig:Button>
    </div>
{% endblock %}

{% block content %}
    <turbo-frame id="plant-list">
        {% if pager.isEmpty() %}
            <twig:EmptyState message="You have no plants yet. Create your first one!">
                {% block actions %}
                    <twig:Button href="{{ path('plant_new') }}" color="primary">New Plant</twig:Button>
                {% endblock %}
            </twig:EmptyState>
        {% else %}
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {% for plant in pager.items %}
                    {% include 'plant/_card.html.twig' with {plant: plant} %}
                {% endfor %}
            </div>

            <div class="mt-8">
                <twig:Pagination :pager="pager" route="plant_index" />
            </div>
        {% endif %}
    </turbo-frame>
{% endblock %}
