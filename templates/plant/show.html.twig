{% extends 'layout/dashboard.html.twig' %}

{% block page_title %}{{ plant.localName }}{% endblock %}

{% block title_display %}
    <div class="flex justify-between items-center">
        <span>{{ plant.localName }}</span>
        <div class="flex gap-2">
            {% if has_permission('plant.edit') %}
                <twig:Button href="{{ path('plant_update', {plantId: plant.id}) }}" color="primary" size="sm">Edit</twig:Button>
            {% endif %}
            {% if has_permission('plant.delete') %}
                <twig:Button color="error" size="sm" data-modal-target="delete-modal" data-modal-toggle="delete-modal">Delete</twig:Button>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block content %}
    <nav class="flex mb-6" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-2 rtl:space-x-reverse">
            <li class="inline-flex items-center">
                <a href="{{ path('plant_index') }}" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600 dark:text-gray-400 dark:hover:text-white">
                    Plants
                </a>
            </li>
            <li aria-current="page">
                <div class="flex items-center">
                    <svg class="rtl:rotate-180 w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                    </svg>
                    <span class="ms-1 text-sm font-medium text-gray-500 md:ms-2 dark:text-gray-400">{{ plant.localName }}</span>
                </div>
            </li>
        </ol>
    </nav>

    <twig:Card>
        {% block content %}
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-500 dark:text-gray-400">
                    <tbody>
                        {% if plant.genus %}
                            <tr class="border-b border-gray-200 dark:border-gray-700">
                                <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Genus</th>
                                <td class="px-6 py-4">{{ plant.genus }}</td>
                            </tr>
                        {% endif %}
                        {% if plant.epithet %}
                            <tr class="border-b border-gray-200 dark:border-gray-700">
                                <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Epithet</th>
                                <td class="px-6 py-4">{{ plant.epithet }}</td>
                            </tr>
                        {% endif %}
                        {% if plant.cultivar %}
                            <tr class="border-b border-gray-200 dark:border-gray-700">
                                <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Cultivar</th>
                                <td class="px-6 py-4">{{ plant.cultivar }}</td>
                            </tr>
                        {% endif %}
                        <tr class="border-b border-gray-200 dark:border-gray-700">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Hybrid</th>
                            <td class="px-6 py-4">{{ plant.isHybrid ? 'Yes' : 'No' }}</td>
                        </tr>
                        <tr class="border-b border-gray-200 dark:border-gray-700">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Lifecycle</th>
                            <td class="px-6 py-4"><twig:Badge>{{ plant.lifecycle.value|capitalize }}</twig:Badge></td>
                        </tr>
                        <tr class="border-b border-gray-200 dark:border-gray-700">
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Created</th>
                            <td class="px-6 py-4">{{ plant.createdAt|date('F j, Y') }}</td>
                        </tr>
                        <tr>
                            <th class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">Updated</th>
                            <td class="px-6 py-4">{{ plant.updatedAt|date('F j, Y') }}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        {% endblock %}
    </twig:Card>

    {{ include('custom_attribute/_show.html.twig') }}

    {% if has_permission('plant.delete') %}
        <twig:ConfirmDeleteModal
            action="{{ path('plant_delete', {plantId: plant.id}) }}"
            entityName="{{ plant.localName }}"
        />
    {% endif %}
{% endblock %}
