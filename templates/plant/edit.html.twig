{% extends 'layout/dashboard.html.twig' %}

{% block page_title %}Edit {{ plant.localName }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <a href="{{ path('plant_show', {plantId: plant.id}) }}" class="text-blue-600 hover:underline dark:text-blue-500 text-sm">&larr; Back to {{ plant.localName }}</a>
    </div>

    <twig:Card>
        {% block content %}
            {{ form_start(form) }}
                {{ form_rest(form) }}
            {{ form_end(form) }}
        {% endblock %}
    </twig:Card>
{% endblock %}
