{% extends 'base.html.twig' %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
{% endblock %}

{% block title %}Register{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-gray-50 px-4">
    <div class="w-full max-w-md bg-white rounded-lg shadow-md p-8">
        <h1 class="text-2xl font-bold text-center text-gray-900 mb-6">Create an account</h1>

        {% for message in app.flashes('error') %}
            <div class="mb-4 p-3 bg-red-100 border border-red-400 text-red-700 rounded">
                {{ message }}
            </div>
        {% endfor %}

        {{ form_start(registrationForm, {'attr': {'class': 'space-y-4'}}) }}
            <div>
                {{ form_label(registrationForm.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500'}}) }}
                {{ form_errors(registrationForm.email, {'attr': {'class': 'text-sm text-red-600 mt-1'}}) }}
            </div>

            <div>
                {{ form_label(registrationForm.displayName, 'Display name', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(registrationForm.displayName, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500'}}) }}
                {{ form_errors(registrationForm.displayName, {'attr': {'class': 'text-sm text-red-600 mt-1'}}) }}
            </div>

            <div>
                {{ form_label(registrationForm.plainPassword, 'Password', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-green-500'}}) }}
                {{ form_errors(registrationForm.plainPassword, {'attr': {'class': 'text-sm text-red-600 mt-1'}}) }}
            </div>

            <div class="flex items-start">
                {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mt-1 h-4 w-4 text-green-600 border-gray-300 rounded focus:ring-green-500'}}) }}
                <label for="{{ registrationForm.agreeTerms.vars.id }}" class="ml-2 block text-sm text-gray-700">
                    I agree to the terms and conditions
                </label>
            </div>
            {{ form_errors(registrationForm.agreeTerms, {'attr': {'class': 'text-sm text-red-600 mt-1'}}) }}

            <button type="submit"
                class="w-full bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition">
                Register
            </button>
        {{ form_end(registrationForm) }}

        <p class="mt-6 text-center text-sm text-gray-600">
            Already have an account?
            <a href="{{ path('app_login') }}" class="text-green-600 hover:text-green-500 font-medium">Log in</a>
        </p>
    </div>
</div>
{% endblock %}
