includes:
    - phpstan-baseline.neon

parameters:
    phpVersion: 80500
    level: 6
    paths:
        - src/
        - tests/
    excludePaths:
        - var/
        - vendor/
        - tests/bootstrap.php
        - tests/object-manager.php
    symfony:
        containerXmlPath: var/cache/dev/GardenManager_KernelDevDebugContainer.xml
    doctrine:
        objectManagerLoader: tests/object-manager.php
