# Environment
APP_SHARE_DIR=var/share

# Router
DEFAULT_URI=https://gardenmanager.local

# Datbase
DATABASE_URL="postgresql://app:!ChangeMe!@postgres:5432/app?serverVersion=17&charset=utf8"

# Messenger
MESSENGER_TRANSPORT_DSN=redis://valkey:6379/messages
MESSENGER_FAILED_TRANSPORT_DSN=redis://valkey:6379/failed

# Mailer
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@gardenmanager.local

# Application config
GM_OIDC__CLIENT_ID=
GM_OIDC__CLIENT_SECRET=
GM_OIDC__ISSUER_URL=
